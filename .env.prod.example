# Production env template for popularity.marketmaker.cc.
# Copy to `.env` on the server and fill in real secrets. NEVER commit the
# filled-in file. The server `.env` is the source of truth — append keys,
# don't overwrite an existing one that already holds secrets.

# Postgres
POSTGRES_USER=popularity
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=popularity
DATABASE_URL=postgres://popularity:__CHANGE_ME__@postgres:5432/popularity?sslmode=disable

# Backend
BACKEND_PORT=8080

# Auth (auth.marketmaker.cc) — production verifies real JWTs.
AUTH_ISSUER=auth.marketmaker.cc
AUTH_JWKS_URL=https://auth.marketmaker.cc/.well-known/jwks.json
AUTH_SERVICE_NAME=popularity
INSECURE_SKIP_AUTH=false

# Frontend (baked into the Next.js build — must be the public URLs).
NEXT_PUBLIC_API_URL=https://popularity.marketmaker.cc
NEXT_PUBLIC_AUTH_URL=https://auth.marketmaker.cc/api/v1

# Scheduler
FETCH_CRON=0 3 * * *
FETCH_WORKERS=4

# Platform credentials (fill in or leave blank to disable a parser)
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
STACKEXCHANGE_KEY=
GITHUB_TOKEN=
DISCORD_BOT_TOKEN=
REDDIT_BEARER_TOKEN=
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# camoufox stealth-scraping fallback (optional). Leave blank to disable.
CAMOUFOX_URL=
